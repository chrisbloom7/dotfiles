{
  "model": "sonnet",
  "advisorModel": "opus",
  "theme": "auto",
  "skipWorkflowUsageWarning": true,
  "disableClaudeAiConnectors": true,
  "syncClaudeAiPlugins": false,
  "syncClaudeAiSkills": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_MOUSE_CLICKS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git push -u origin *)",
      "Bash(gh pr create:*)",
      "Bash(wt list)",
      "Bash(wt list *)",
      "Bash(git fetch)",
      "Bash(git fetch -q)",
      "Bash(git fetch --prune)",
      "Bash(git fetch -q --prune)",
      "Bash(git fetch origin)",
      "Bash(git merge-base *)",
      "Bash(towit doctor)",
      "Bash(towit version)",
      "Bash(towit list *)",
      "Bash(towit search *)",
      "Bash(towit show *)",
      "Bash(psql -l)",
      "Bash(psql -lqt)",
      "Bash(psql --version)",
      "Bash(docker info)",
      "Bash(brew list *)",
      "Bash(brew services list)",
      "mcp__claude-artifacts__get_artifact",
      "mcp__claude-artifacts__guide",
      "mcp__plugin_playwright_playwright__browser_take_screenshot"
    ],
    "ask": [
      "Bash(git push *main*)",
      "Bash(git push *develop*)",
      "Bash(git push *master*)",
      "Bash(wt merge)",
      "Bash(wt merge *)",
      "Bash(git worktree add *)"
    ]
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "remember@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "frontend-design-audit@frontend-design-audit": true,
    "security-guidance@anthropic-plugin-directory": true,
    "claude-code-setup@anthropic-plugin-directory": true,
    "claude-security@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "feature-dev@anthropic-plugin-directory": true,
    "frontend-design@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": true,
    "playground@anthropic-plugin-directory": true,
    "playwright@anthropic-plugin-directory": true,
    "code-review-anthropics@anthropic-plugin-directory": true,
    "ruby-lsp@anthropic-plugin-directory": true,
    "typescript-lsp@claude-plugins-official": true,
    "chrisbloom7-development@ai-tools": true,
    "github@anthropic-plugin-directory": false,
    "design@anthropic-plugin-directory": true,
    "stripe@claude-plugins-official": true,
    "context7@anthropic-plugin-directory": true,
    "plugin-dev@anthropic-plugin-directory": true,
    "towit@to-wit": true,
    "resend@claude-plugins-official": true,
    "railway@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "frontend-design-audit": {
      "source": {
        "source": "github",
        "repo": "mistyhx/frontend-design-audit"
      }
    },
    "ai-tools": {
      "source": {
        "source": "github",
        "repo": "chrisbloom7/ai-tools"
      }
    },
    "to-wit": {
      "source": {
        "source": "github",
        "repo": "chrisbloom7/to-wit",
        "ref": "v0.14.0"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/check-macdown-hash.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  }
}
