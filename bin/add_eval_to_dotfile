#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
source "${PWD}/helpers/trap_and_trace.sh"
PATH="${PWD}:${PATH}"

if [[ $# -lt 2 ]]; then
  log_error "You must provide at least two arguments"
  exit 1
fi

gate="${1}"
subject="${2:?Subject is required}"
: ${3:?You must provide at least one target file}
targets=("${@:3}")

log_debug "Checking for \`${subject}\` in ${targets[*]}"
new_eval="eval \"\$(${subject})\""
for target in "${@:3}"; do
  if [[ ! -f $target ]]; then
    log_debug "Target file ${target} does not exist yet; touching"
    mkdir -p "$(dirname "${target}")"
    touch "${target}"
  fi

  # Compare ignoring double quotes so `eval "$("/x/brew" shellenv)"` matches an
  # existing `eval "$(/x/brew shellenv)"` instead of being appended again
  target_content="$(cat "${target}")"
  if [[ "${target_content//\"/}" == *"${new_eval//\"/}"* ]]; then
    log_attention "\`${new_eval}\` already exists in ${target}; skipping"
  else
    # Build the gated line per target; reassigning new_eval would stack the
    # gate and `|| true` again for every later file
    line="${new_eval}"
    if [[ -n "${gate:-}" ]]; then
      line="${gate} && ${new_eval} || true"
    fi
    log_debug "Adding \`${line}\` to ${target}"
    echo "${line}" >> "${target}"
  fi
done

# #######################################
# # Write a line to a file only if that line isn't already present.
# # Arguments:
# #   $1 = File to write to
# #   $2 = Line to write
# #######################################
