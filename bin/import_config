#!/usr/bin/env bash
# Moves existing config files under $HOME into configs/<tool>/ at the same
# relative path, then links them back into place with link_configs.
#
# Usage:
#   import_config <tool-name> <path> [<path> ...]
#   import_config <path> [<path> ...]   # interactive tool selection (requires fzf)
#
# The first argument is treated as a tool name unless it contains "/" or starts
# with "~". Each path may be a file or a directory and must be under $HOME. A
# new configs/<tool>/ folder is created if needed.
#
# Examples:
#   import_config mise ~/.config/mise/config.toml
#   import_config claude ~/.claude/keybindings.json ~/.claude/settings.json
#   import_config ~/.gitconfig    # prompts for the tool folder
set -euo pipefail
caller_dir="${PWD}"
cd "$(dirname "$0")"
source "${PWD}/helpers/trap_and_trace.sh"
PATH="${PWD}:${PATH}"

configs_dir="${DOTFILES_CONFIGS:-$(cd "${PWD}/../configs" && pwd)}"

if [[ -z "${1:-}" ]]; then
  log_error "At least one path to import is required"
  exit 1
elif [[ "${1}" == *"/"* ]] || [[ "${1}" == "~"* ]]; then
  tool=""
else
  tool="$1"
  shift
fi

if [[ $# -eq 0 ]]; then
  log_error "At least one path to import is required"
  exit 1
fi

# ---------------------------------------------------------------------------
# Resolve each path relative to $HOME, failing fast before any prompts
# ---------------------------------------------------------------------------
rel_paths=()
for path in "$@"; do
  path="${path/#\~/$HOME}"
  [[ "${path}" == /* ]] || path="${caller_dir}/${path}"
  if [[ ! -e "${path}" ]] && [[ ! -L "${path}" ]]; then
    log_error "${path} not found"
    exit 1
  fi

  # Absolute path without resolving the final component, which may be a symlink
  path="$(cd "$(dirname "${path}")" && pwd)/$(basename "${path}")"
  if [[ "${path}" != "${HOME}/"* ]]; then
    log_error "${path} is not under ${HOME}"
    exit 1
  fi
  rel_paths+=("${path#"${HOME}/"}")
done

# ---------------------------------------------------------------------------
# Interactive tool selection (when no tool name was given)
# ---------------------------------------------------------------------------
if [[ -z "${tool}" ]]; then
  if ! command -v fzf &>/dev/null; then
    log_error "fzf is required for interactive folder selection (brew install fzf)"
    exit 1
  fi

  existing_tools=()
  while IFS= read -r dir; do
    existing_tools+=("$(basename "${dir}")")
  done < <(find "${configs_dir}" -mindepth 1 -maxdepth 1 -type d | sort)

  NEW_FOLDER_OPTION="[New config folder]"
  choice=$(printf '%s\n' "${existing_tools[@]}" "${NEW_FOLDER_OPTION}" | \
    fzf --prompt="Config folder for ${rel_paths[*]}: " \
        --height=40% \
        --layout=reverse) || true

  if [[ "${choice}" == "${NEW_FOLDER_OPTION}" ]]; then
    read -rp "New tool name: " tool
  else
    tool="${choice}"
  fi

  if [[ -z "${tool}" ]]; then
    log_error "No config folder selected"
    exit 1
  fi
fi

tool_dir="${configs_dir}/${tool}"
if [[ ! -d "${tool_dir}" ]]; then
  log_info "Creating ${tool_dir}"
  mkdir -p "${tool_dir}"
fi

# ---------------------------------------------------------------------------
# Move each path into the tool folder
# ---------------------------------------------------------------------------
for rel in "${rel_paths[@]}"; do
  src="${HOME}/${rel}"
  dest="${tool_dir}/${rel}"

  if [[ -L "${src}" ]] && [[ "$(readlink "${src}")" == "${configs_dir}/"* ]]; then
    log_attention "${src} is already managed by this repo; skipping"
    continue
  fi

  if [[ -e "${dest}" ]] || [[ -L "${dest}" ]]; then
    log_attention "${dest} already exists in dotfiles; skipping"
    continue
  fi

  mkdir -p "$(dirname "${dest}")"
  log_info "Moving ${src} → ${dest}"
  mv "${src}" "${dest}"
done

link_configs "${tool}"

log_success "Done! ${tool} configs are managed in ${tool_dir}"
